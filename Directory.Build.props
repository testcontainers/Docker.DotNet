<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <DockerVersion>v29.8.0</DockerVersion>
  </PropertyGroup>
  <!-- Strong-naming -->
  <PropertyGroup Label="Signing">
    <DebugType>embedded</DebugType>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)\Key.snk</AssemblyOriginatorKeyFile>
    <!-- The public key of Key.snk. The SDK uses it for InternalsVisibleTo items that do not specify a key. -->
    <PublicKey></PublicKey>
  </PropertyGroup>
</Project>